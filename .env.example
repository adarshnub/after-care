# Local development only. Set production values in Vercel's Environment Variables.
# On Vercel, APP_URL can be blank to use Vercel's generated domains automatically.
# With a custom domain, set APP_URL in Production only to its exact HTTPS origin.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI organization and grounded care assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Run npm run setup:push to generate missing local keys and CRON_SECRET privately.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:care@your-hospital.example
CRON_SECRET=

# Set temporarily only when provisioning a new nurse; otherwise leave blank.
STAFF_PROVISIONING_SECRET=

# Local evaluation only. File-backed demo access is always disabled on Vercel.
ALLOW_DEMO=false
